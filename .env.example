# eCom Agent — your personal settings. Copy this file to `.env` and fill it in.
# `.env` stays on your computer: it is gitignored and excluded from release zips.

# shexp68 (盛世领航) account — the 账号登录 username/password of http://www.shexp68.com/
# Used to log in automatically before each declaration. JD and Taobao use QR/manual login instead.
SHEXP68_USERNAME=
SHEXP68_PASSWORD=

# Optional: the 集运仓库 to declare into (must match the option text on the 添加包裹 form).
# SHEXP68_WAREHOUSE=深圳集运仓库

# Optional: where the login profile, order database and raw dumps are stored (default: ./data).
# ECOM_DATA_DIR=data
